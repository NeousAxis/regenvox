# RegenVox : application d'une seule page, toutes les adresses renvoient vers index.html.
RewriteEngine On
RewriteBase /
# Le https est géré en amont chez Infomaniak : on se fie à l'en-tête X-Forwarded-Proto.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
# Données publiques déjà compressées : servies telles quelles, décompressées par la page.
<FilesMatch "\.json\.gz$">
  ForceType application/octet-stream
  <IfModule mod_headers.c>
    Header unset Content-Encoding
  </IfModule>
</FilesMatch>

# Cache : la page d'entrée est revérifiée à chaque visite (sinon un navigateur garde une ancienne version
# qui appelle des fichiers déjà retirés) ; les fichiers de assets/ portent une empreinte et ne changent jamais.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
